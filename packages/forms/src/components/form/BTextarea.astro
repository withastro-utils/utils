---
import { getFormContext, type AstroFormsProps } from '../../form-tools/form-context.js';
import { validateFormInput } from '../../components-control/input-parse.js';
import { validateFrom } from '../../form-tools/csrf.js';
import type { Component, ComponentProps, ModifyDeep } from '../../utils.js';
import { getProperty } from 'dot-prop';
import { addOnSubmitClickEvent } from '../../form-tools/events.js';
import { MissingNamePropError } from '../../errors/MissingNamePropError.js';
import type { ZodType } from 'zod';
import type { HTMLTag } from 'astro/types';

interface ModifyInputProps {
    minlength?: number;
    maxlength?: number;
    [key: `data-${string}`]: any;
}

export type Props<T extends HTMLTag | Component = 'textarea'> = Partial<ModifyDeep<astroHTML.JSX.TextareaHTMLAttributes, ModifyInputProps>> & AstroFormsProps & {
    name: string;
    errorMessage?: string;
    validate?: Function | ZodType;
    as?: T;
    props?: ComponentProps<T>;
    onSubmitClick?: string;
    [key: `data-${string}`]: any;
};

if (!Astro.props.name) {
    throw new MissingNamePropError('BTextarea');
}

const { bind, method, onSubmitClickGlobal, bindId: parentBindId = ''  } = getFormContext(Astro);

if (!Astro.props.disabled && method === 'POST' && (await validateFrom(Astro))) {
    await validateFormInput(Astro, bind, parentBindId);
}

const { as: asComponent = 'textarea', props: componentProps, value: defaultValue, onSubmitClick = onSubmitClickGlobal, __astroForms, ...props } = Astro.props;
addOnSubmitClickEvent(onSubmitClick, props);

const value = getProperty(bind, Astro.props.name, (await Astro.slots.render('default')) ?? defaultValue);

const Component = asComponent as any;
---

<Component {...props} name={parentBindId + props.name} {...componentProps}>{value}</Component>
