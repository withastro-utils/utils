---
import { getFormContext, type AstroFormsProps } from '../../form-tools/form-context.js';

export interface Props extends astroHTML.JSX.HTMLAttributes, AstroFormsProps {
    title?: string;
};

const {bind, settings} = getFormContext(Astro);
const {title, __astroForms, ...props} = Astro.props;
---
{bind.errors.length && settings.showValidationErrors &&
<div {...props}>
    {title && <h4>{title}</h4>}
    <ol>
        {bind.errors.map((x: { message: string; name: string }) =>
                <li>{x.message}: "{x.name}"</li>)}
    </ol>
</div> || ''}
