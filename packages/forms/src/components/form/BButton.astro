---
import { asyncFormContext, getAstroFormsMetadata, getFormContext, type AstroFormsProps } from '../../form-tools/form-context.js';
import { isPost, validateAction } from '../../form-tools/post.js';
import { diffProps, omitProps } from '../../components-control/props-utils.js';
import objectAssignDeep from 'object-assign-deep';
import { MissingClickActionError } from '../../errors/MissingClickActionError.js';
import { claimGeneratedId } from '../../form-tools/generated-id.js';
import type { HTMLTag } from 'astro/types';
import type { Component, ComponentProps } from '../../utils.js';

export type Props<T extends HTMLTag | Component = 'button'> = ComponentProps<T> & AstroFormsProps & {
    onClick: Function;
    connectId?: string;
    whenFormOK?: boolean;
    as?: T;
    props?: ComponentProps<T>;
    state?: any;
    extra?: any;
};

const { as: asComponent = 'button', props: componentProps, onClick, whenFormOK, connectId, __astroForms, ...props } = Astro.props;
if (typeof onClick !== 'function') {
    throw new MissingClickActionError();
}

componentProps && Object.assign(props, componentProps);

const context = getFormContext(Astro);
const { bind, executeAfter, elementsState, tempValues, buttonIds, settings, bindId: parentBindId = '' } = context;
const elementPropsState = elementsState || tempValues;
const metadata = getAstroFormsMetadata(Astro)!;

const fullBindId = parentBindId + metadata.id;
const buttonUniqueId = connectId ?? fullBindId;
const releaseGeneratedId = claimGeneratedId(Astro, buttonUniqueId, !connectId && !!metadata.generated, 'BButton');

let innerText: any;
let doNotWriteHTML: any;
let changedProps: any;
let Component: any;
let slotData: string;
try {
const allProps = {
    ...props,
    ...elementPropsState[buttonUniqueId],
    defaults: props,
    bind,
    reset() {
        for (const key of Object.keys(allProps)) {
            delete allProps[key];
        }
        Object.assign(allProps, props);
    },
};

// add this button to list of button for the default submit action
if (buttonIds && !allProps.disabled) {
    buttonIds.push([buttonUniqueId, allProps.id, whenFormOK]);
}

async function executeFormAction(callback: Function = onClick) {
    const validAction = isPost(Astro) && (await validateAction(Astro, 'button-callback', buttonUniqueId));

    if (validAction && whenFormOK && settings) {
        settings.showValidationErrors = true;
    }

    const checkFormValidation = (whenFormOK && !bind?.errors.length) || !whenFormOK;
    if (checkFormValidation && validAction) {
        const originalProps = objectAssignDeep({}, { ...props, extra: null });

        if (!allProps.disabled) {
            await Astro.locals.forms.___runWithSettings(settings, () => callback.call(allProps));
        }

        elementPropsState[buttonUniqueId] = diffProps(originalProps, allProps, ['extra', 'bind', 'reset', 'defaults']);
    }
}

if (executeAfter) {
    executeAfter.push(() => asyncFormContext(executeFormAction, Astro, context));
} else if (whenFormOK) {
    throw new Error('Use BButton with `whenFormOK` inside a BindForm component');
} else {
    await executeFormAction();
}

let innerHTML: any;
({ innerText, innerHTML, remove: doNotWriteHTML, ...changedProps } = omitProps(allProps, ['extra', 'bind', 'state', 'reset', 'defaults']));

Component = asComponent as any;
slotData = innerHTML ?? (Astro.slots.has('default') ? await Astro.slots.render('default') : '');
} finally {
    releaseGeneratedId();
}
---

{
    !doNotWriteHTML && (
        <Component type='submit' name='button-callback' value={buttonUniqueId} formNoValidate={!whenFormOK} {...changedProps}>
            {innerText ?? <Fragment set:html={slotData} />}
        </Component>
    )
}
